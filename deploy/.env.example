# Copy to deploy/.env (mode 0600) on the VPS. Steps: docs/deploy.md.
# The public name of the DWN. Its DNS A record (and AAAA record, if any) points to the VPS.
DWN_DOMAIN=dwn.didpkg.dev
# The email of the Let's Encrypt account.
ACME_EMAIL=
# The admin token. Make it with: openssl rand -hex 32
DWN_ADMIN_TOKEN=
