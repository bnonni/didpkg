  "devDependencies": {
    "validate-npm-package-name": "8.0.0"
  },
  "dependencies": {
    "@enbox/dids": "0.1.14",
    "@noble/curves": "2.4.0",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
